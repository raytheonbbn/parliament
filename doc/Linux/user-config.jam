
import os ;

constant LinuxDistro : [ os.environ LINUX_DISTRO ] ;

constant FLAGS_ubuntu26 : <cxxflags>"-Wall" ;
constant FLAGS_ubuntu25 : <cxxflags>"-Wall" ;
constant FLAGS_ubuntu24 : <cxxflags>"-Wall" ;
constant FLAGS_rhel9    : <cxxflags>"-Wall" <linkflags>"-lstdc++fs" ;



# Toolset declarations (the first one is the default):

using gcc
	: # version
	: # c++-compile-command
	: $(FLAGS_$(LinuxDistro))
	;
