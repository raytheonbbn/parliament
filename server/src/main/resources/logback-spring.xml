<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<property name="logDir" value="./log"/>
	<property name="fileNm" value="parliament"/>
	<property name="pattern" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSX} %-5level [%t] %C{1} %m%n"/>

	<appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<Pattern>${pattern}</Pattern>
		</encoder>
	</appender>

	<appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${logDir}/${fileNm}.log</file>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<Pattern>${pattern}</Pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!--
			Rollover daily. Each file should be at most 100MB,
			keep 60 days worth of history, but at most 20GB
			-->
			<fileNamePattern>${logDir}/${fileNm}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>100MB</maxFileSize>    
			<maxHistory>60</maxHistory>
			<totalSizeCap>20GB</totalSizeCap>
		</rollingPolicy>
	</appender>
	
	<root level="info">
		<appender-ref ref="RollingFile"/>
		<appender-ref ref="Console"/>
	</root>

	<logger name="com.bbn.parliament" level="trace" additivity="false">
		<appender-ref ref="RollingFile"/>
		<appender-ref ref="Console"/>
	</logger>
</configuration>
