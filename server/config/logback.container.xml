<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<property name="logDir" value="${log.path.base:-.}/log"/>
	<property name="fileNm" value="parliament"/>

	<appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${logDir}/${fileNm}.log</file>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<!-- %d=date, %p=level, %t=thread, %c=logger, %m=message, %n=newline -->
			<pattern>%d{ISO8601, UTC} %-5p [%t] %c{39} %m%n</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!-- Rollover daily. Per-file limit of 100MB, 60 days of history, but at most 20GB -->
			<fileNamePattern>${logDir}/${fileNm}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>100MB</maxFileSize>    
			<maxHistory>60</maxHistory>
			<totalSizeCap>20GB</totalSizeCap>
		</rollingPolicy>
	</appender>
	
	<root level="info">
		<appender-ref ref="RollingFile"/>
	</root>
</configuration>
